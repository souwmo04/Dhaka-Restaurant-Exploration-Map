# ─── Supabase ────────────────────────────────────────────────────────────────
# Public values (safe for the browser — access is enforced by Row Level Security).
# Local dev: run `npm run db:start` and copy the "API URL" and "anon key" it prints.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used ONLY by scripts/import-restaurants.ts to bulk-load data.
# Never prefix with NEXT_PUBLIC_ and never set it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
# Canonical site URL (used for auth redirects and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to show the "Continue with Google" button. Google must also be
# enabled as a provider in your Supabase project (Authentication → Providers).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ─── Map (optional) ──────────────────────────────────────────────────────────
# Any MapLibre-compatible style URL. Defaults to OpenFreeMap "positron" (OSM data, no key).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
