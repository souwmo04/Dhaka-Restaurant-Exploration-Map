{
  "name": "biteatlas-promo",
  "private": true,
  "version": "1.0.0",
  "description": "BiteAtlas promo video, built with Remotion",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render BiteAtlasPromo out/biteatlas-promo.mp4",
    "still": "remotion still BiteAtlasPromo out/still.png",
    "typecheck": "tsc --noEmit",
    "audio": "python scripts/soundtrack.py",
    "voice": "python scripts/voiceover.py",
    "render:web": "remotion ffmpeg -v error -y -i out/biteatlas-promo.mp4 -c:v libx264 -crf 25 -preset slow -pix_fmt yuv420p -c:a aac -b:a 160k -movflags +faststart out/biteatlas-promo-web.mp4",
    "subtitles": "python scripts/subtitles.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
